// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  password        String
  googleId        String?          @unique
  role            UserRole         @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workHours       WorkHour[]
  collaborators   Collaborator[]
  projects        Project[]
  tasks           Task[]
  settings        Settings?
  notificationLogs NotificationLog[]
  inAppNotifications InAppNotification[]
  workSessions    WorkSession[]
  pushSubscriptions PushSubscription[]
}

model WorkHour {
  id          String              @id @default(uuid())
  date        DateTime
  description String?
  hours       Float
  startTime   String?
  endTime     String?
  userId      String
  companyId   String
  projectId   String?
  taskId      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id])
  company     Company             @relation(fields: [companyId], references: [id])
  project     Project?            @relation(fields: [projectId], references: [id])
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  invoiceWorkHours InvoiceWorkHour[]
}

model Company {
  id          String    @id @default(uuid())
  name        String?
  email       String
  phone       String?
  company     String
  hourlyRate  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  collaborators Collaborator[]
  companyAdmins CompanyAdmin[]
  workHours   WorkHour[]
  invoices    Invoice[]
  addresses   Address[]
  projects    Project[]
  tasks       Task[]
  pendingInvites    PendingInvite[]
  authorizedDomains  AuthorizedDomain[]
}

model Collaborator {
  id        String             @id @default(uuid())
  userId    String
  companyId String
  // MW-24 — origin of the link (PendingInvite / AuthorizedDomain), to
  // show the link type in the Company Dashboard table. Optional: rows
  // created before this column (or directly via prisma in tests) stay
  // null and the UI shows "—".
  origin    CollaboratorOrigin?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model CompanyAdmin {
  id            String         @id @default(uuid())
  companyId     String
  email         String         @unique
  password      String
  invitedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy     CompanyAdmin?  @relation("CompanyAdminInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedAdmins CompanyAdmin[] @relation("CompanyAdminInvitedBy")
  pendingInvitesCreated PendingInvite[]
}

model PendingInvite {
  id                      String                @id @default(uuid())
  companyId               String
  email                   String
  status                  PendingInviteStatus @default(PENDING)
  // MW-26 — opcional + SetNull: Desativação de Company faz hard-delete dos
  // CompanyAdmin da Company, mas o PendingInvite (mesmo já REVOKED/LINKED)
  // continua existindo como histórico. Sem isso, o FK original (RESTRICT)
  // impediria apagar um CompanyAdmin que criou algum convite.
  createdByCompanyAdminId String?
  linkedAt                DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByCompanyAdmin   CompanyAdmin?         @relation(fields: [createdByCompanyAdminId], references: [id], onDelete: SetNull)

  @@unique([companyId, email])
}

model AuthorizedDomain {
  id          String                  @id @default(uuid())
  companyId   String
  domain      String
  status      AuthorizedDomainStatus @default(PENDING)
  confirmedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, domain])
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String?
  companyId   String
  userId      String
  hourlyRate  Float      @default(0)
  alertHours  Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  workHours   WorkHour[]
  tasks       Task[]
}

model Task {
  id           String        @id @default(uuid())
  userId       String
  companyId    String
  projectId    String?
  title        String
  link         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  workHours    WorkHour[]
  workSessions WorkSession[]
}

model Address {
  id          String   @id @default(uuid())
  street      String
  city        String
  state       String
  zipCode     String
  country     String   @default("Brazil")
  type        String   @default("billing") // billing, shipping, office, etc.
  isPrimary   Boolean  @default(false)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Settings {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  alertHours               Float    @default(160)
  notificationEmail        String?
  roundingIncrementMinutes Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id          String              @id @default(uuid())
  number      String?
  companyId   String
  fileUrl     String?
  amount      Float               @default(0)
  status      InvoiceStatus       @default(PENDING)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     Company             @relation(fields: [companyId], references: [id])
  invoiceWorkHours InvoiceWorkHour[]
}

model InvoiceWorkHour {
  id          String   @id @default(uuid())
  invoiceId   String
  workHourId  String
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  workHour    WorkHour @relation(fields: [workHourId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, workHourId])
}

model NotificationLog {
  id           String           @id @default(uuid())
  userId       String
  companyId    String?
  type         NotificationType
  threshold    Float
  totalHours   Float
  sentAt       DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id])

  @@index([userId, type, threshold])
  @@index([userId, companyId, type, threshold])
}

model InAppNotification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String
  type        InAppNotificationType @default(INFO)
  read        Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model WorkSession {
  id                      String            @id
  userId                  String
  status                  WorkSessionStatus @default(RUNNING)
  startedAt               DateTime
  currentSegmentStartedAt DateTime?
  accumulatedSeconds      Int               @default(0)
  lastPromptAt            DateTime?
  lastConfirmedAt         DateTime?
  promptNonce             String?
  companyId               String?
  projectId               String?
  taskId                  String?
  description             String?
  hours                   Float?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id])
  task                    Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model WorkSessionSyncedEvent {
  eventId   String   @id
  sessionId String
  type      String
  appliedAt DateTime @default(now())
}

enum WorkSessionStatus {
  RUNNING
  PAUSED
  STOPPING
  ENDED
  DISCARDED
}

enum InAppNotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationType {
  HOURS_THRESHOLD
  INVOICE_UPLOADED
  WELCOME
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELED
}

enum UserRole {
  USER
  ADMIN
}

enum PendingInviteStatus {
  PENDING
  LINKED
  REVOKED
}

enum AuthorizedDomainStatus {
  PENDING
  CONFIRMED
  REVOKED
}

enum CollaboratorOrigin {
  INVITE
  DOMAIN
}
